# ==========================================
# MongoDB Vector Store Configuration
# ==========================================
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net"
DB_NAME="rag_data"
COLLECTION_NAME="embeddings"

# ==========================================
# PostgreSQL / Supabase pgvector Configuration
# ==========================================
user="postgres"
password="your_postgres_password"
host="localhost"
port="5432"
dbname="postgres"

# Optional fallback direct connection string
# PG_CONNECTION_STRING="postgresql+pg8000://postgres:password@localhost:5432/postgres"

# ==========================================
# LLM Provider Configuration ("gemini" or "ollama")
# ==========================================
LLM_PROVIDER="gemini"

# Google Gemini API
GOOGLE_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Ollama Local LLM (if LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# ==========================================
# RAG & Embeddings
# ==========================================
TOP_K=8
DATA_PATH="data"

# ==========================================
# Authentication & JWT Security
# ==========================================
JWT_SECRET_KEY="generate-a-strong-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
